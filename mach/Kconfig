# Machine families
config MACH_FAMILY_XIAOMI_MTP
	bool

config MACH_FAMILY_XIAOMI_QRD
	bool

config MACH_FAMILY_XIAOMI_QRD_SDM450
	bool
	depends on ARCH_SDM450
	select MACH_FAMILY_XIAOMI_QRD

config MACH_FAMILY_XIAOMI_QRD_MSM8953
	bool
	depends on ARCH_MSM8953
	select MACH_FAMILY_XIAOMI_QRD

# Machines
config MACH_XIAOMI_MSM8953
	bool "Xiaomi MSM8953"
	help
	  Support for Xiaomi MSM8953.

config MACH_XIAOMI_ROSY
	bool "Xiaomi Redmi 5 (rosy)"
	select MACH_FAMILY_XIAOMI_QRD_SDM450
	help
	  Support for Xiaomi Redmi 5 (rosy).

